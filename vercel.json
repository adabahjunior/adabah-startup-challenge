{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js?__endpoint=$1"
    },
    {
      "source": "/api",
      "destination": "/api/index.js?__endpoint="
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.js?__upload=$1"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/dashboard/(.*)",
      "destination": "/dashboard.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin.html"
    },
    {
      "source": "/apply",
      "destination": "/apply.html"
    },
    {
      "source": "/join",
      "destination": "/join.html"
    },
    {
      "source": "/join/(.*)",
      "destination": "/join.html"
    }
  ]
}
